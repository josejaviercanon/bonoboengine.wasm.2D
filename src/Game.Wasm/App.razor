@using Game.Engine.ECS
@using Game.Engine.ECS.Tetris
@using Game.Engine.ECS.Snake
@using Game.Engine.ECS.Breakout
@using Game.Engine.ECS.Asteroids
@using Game.Engine.ECS.Pacman
@using Game.Engine.ECS.Racer
@using System.Text.Json
@using Microsoft.JSInterop
@inject IJSRuntime JS
@inject EcsSimulation EcsSim
@inject TetrisSimulation TetrisSim
@inject SnakeSimulation SnakeSim
@inject BreakoutSimulation BreakoutSim
@inject AsteroidsSimulation AsteroidsSim
@inject PacmanSimulation PacmanSim
@inject RacerSimulation RacerSim
@implements IDisposable

<Routes />

@code {
    private static readonly JsonSerializerOptions JsonOpts = new()
    {
        PropertyNamingPolicy = JsonNamingPolicy.CamelCase,
    };

    private readonly List<Action> _unsubs = [];

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        // Register the command handler so scenes can call postCommand → C# sims.
        await JS.InvokeVoidAsync("registerGameWasmProvider",
            DotNetObjectReference.Create(new CommandHandler(
                TetrisSim, SnakeSim, BreakoutSim, AsteroidsSim, PacmanSim, RacerSim)));

        // Subscribe to each sim's render signal and deliver JSON to JS.
        Subscribe<EcsRenderSignal>(EcsSim, "sprite-move");
        Subscribe<TetrisRenderSignal>(TetrisSim, "tetris-move");
        Subscribe<SnakeRenderSignal>(SnakeSim, "snake-move");
        Subscribe<BreakoutRenderSignal>(BreakoutSim, "breakout-move");
        Subscribe<AsteroidsRenderSignal>(AsteroidsSim, "asteroids-move");
        Subscribe<PacmanRenderSignal>(PacmanSim, "pacman-move");
        Subscribe<RacerRenderSignal>(RacerSim, "racer-move");
    }

    private void Subscribe<T>(dynamic sim, string eventName)
    {
        Action<T> handler = signal =>
        {
            var json = JsonSerializer.Serialize(signal, JsonOpts);
            _ = JS.InvokeVoidAsync("onRenderSignal", eventName, json);
        };
        sim.OnRenderSignal += handler;
        _unsubs.Add(() => sim.OnRenderSignal -= handler);
    }

    public void Dispose()
    {
        foreach (var unsub in _unsubs) unsub();
    }
}
